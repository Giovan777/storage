// Upload file to storage bucket
export async function uploadAuditFile(fileUri, fileName) {
  const response = await fetch(fileUri);
  const fileBlob = await response.blob();

  const { data, error } = await supabase.storage
    .from('Bolt_Inspex Audit Management') // your bucket name
    .upload(`inspections/${fileName}`, fileBlob, {
      cacheControl: '3600',
      upsert: false,
    });

  if (error) {
    console.error('Upload failed:', error.message);
    return null;
  }
  return data;
}

// Download file
export async function getAuditFileUrl(path) {
  const { data } = supabase.storage
    .from('audit-files')
    .getPublicUrl(path);

  return data?.publicUrl || null;
}
